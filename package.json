{
  "name": "polymorph-ui-components",
  "version": "0.6.0",
  "description": "A themeable Svelte 5 UI component library with CSS custom property driven styling",
  "keywords": [
    "svelte",
    "svelte5",
    "ui",
    "components",
    "component-library",
    "design-system",
    "css-variables",
    "themeable",
    "svelte-components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinha-sahil/polymorph-ui-components.git"
  },
  "bugs": {
    "url": "https://github.com/sinha-sahil/polymorph-ui-components/issues"
  },
  "homepage": "https://github.com/sinha-sahil/polymorph-ui-components#readme",
  "author": "Sahil Sinha",
  "scripts": {
    "prepare": "husky",
    "dev": "vite dev --host",
    "build": "vite build && npm run package",
    "build:wc": "vite build --config vite.config.wc.ts",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "test": "npm run test:integration && npm run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:wc": "svelte-check --tsconfig ./tsconfig.wc.json --compiler-warnings \"options_missing_custom_element:ignore\"",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check src && eslint src",
    "format": "prettier --write src",
    "test:integration": "playwright test",
    "test:unit": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "svelte": "^5.41.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.1",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "marked": "^18.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "publint": "^0.3.21",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "auto-changelog": {
    "output": "docs/CHANGELOG.md",
    "template": "./docs/templates/changelog.hbs",
    "commitLimit": false,
    "breakingPattern": "(!:)",
    "unreleased": true,
    "releaseSummary": true,
    "hideCredit": false,
    "ignoreCommitPattern": "(\\[skip ci\\])"
  }
}
